										<img width="900" height="600" src="https://elementor.example.com/wp-content/uploads/2024/01/garten.png" alt="Ein Garten im Sommer" srcset="https://elementor.example.com/wp-content/uploads/2024/01/garten.png 900w, https://elementor.example.com/wp-content/uploads/2024/01/garten-300x200.png 300w, https://elementor.example.com/wp-content/uploads/2024/01/garten-768x512.png 768w" sizes="(max-width: 900px) 100vw, 900px" />											<figcaption>Ein Garten im Sommer</figcaption>
										</figure>
												<ul>
							<li>
											<a href="https://elementor.example.com/kontakt/">
