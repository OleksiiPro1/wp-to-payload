{
  "name": "wp-to-payload",
  "version": "0.1.0",
  "description": "Migrate WordPress sites to Payload CMS 3 from a WXR export file: analyze, scaffold, import and redirects.",
  "license": "MIT",
  "author": "Oleksii Piltenko, Wien Webstudio (https://wienwebstudio.at)",
  "type": "module",
  "bin": {
    "wp-to-payload": "dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OleksiiPro1/wp-to-payload.git"
  },
  "homepage": "https://github.com/OleksiiPro1/wp-to-payload#readme",
  "bugs": {
    "url": "https://github.com/OleksiiPro1/wp-to-payload/issues"
  },
  "keywords": [
    "wordpress",
    "payload",
    "payloadcms",
    "wxr",
    "migration",
    "lexical",
    "cli"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:external": "vitest run --project external",
    "prepack": "npm run build"
  },
  "dependencies": {
    "jsdom": "^30.1.3",
    "sax": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/sax": "^1.2.7",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
